# ══════════════════════════════════════════════════════════════════════════════
# REIS — Environment Configuration
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# ── Database (TimescaleDB) ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=reis
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION    # ⚠️ Change this!
DB_NAME=reis_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=reis-consumer-group

# ── Collection Schedule ──────────────────────────────────────────────────────
COLLECTION_INTERVAL_MINUTES=15

# ── LLM / Generative AI ─────────────────────────────────────────────────────
# At least ONE of these keys must be set for AI insights
GEMINI_API_KEY=                        # Get from https://aistudio.google.com/
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=                        # Fallback — Get from https://platform.openai.com/
OPENAI_MODEL=gpt-4o-mini

# Cache TTL
INSIGHT_CACHE_TTL_SECONDS=3600         # 1 hour
INFERENCE_CACHE_TTL_SECONDS=600        # 10 minutes

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false                         # true for JSON logs in production

# ── Telegram Alerts ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                    # Create bot via @BotFather
TELEGRAM_CHAT_ID=                      # Your chat/group ID

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── CORS (comma-separated origins) ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
