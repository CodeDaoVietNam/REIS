# REIS — Environment Variables Template
# Copy this file to .env and fill in your values
# .env is in .gitignore — NEVER commit real values

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reis:reis_secret@localhost:5432/reis_db
ASYNC_DATABASE_URL=postgresql+asyncpg://reis:reis_secret@localhost:5432/reis_db
POSTGRES_USER=reis
POSTGRES_PASSWORD=reis_secret
POSTGRES_DB=reis_db

# ── Kafka ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── APIs ──────────────────────────────────────────────────────────────
# Mapbox Geocoding API — get your token at https://account.mapbox.com/
MAPBOX_TOKEN=pk.your_mapbox_token_here

# ── Airflow ───────────────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=change_this_to_32_character_random_string

# ── MLflow ───────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── FastAPI ───────────────────────────────────────────────────────────
API_PORT=8000
ENV=development
LOG_LEVEL=INFO

# ── LLM ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_key_here

# ── Alert Manager ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── ML Thresholds ─────────────────────────────────────────────────────
ANOMALY_THRESHOLD=0.70
CRITICAL_THRESHOLD=0.85
INSIGHT_CACHE_TTL=3600

# ── Frontend ──────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws
