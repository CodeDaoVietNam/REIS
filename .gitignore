# ── Environment & Secrets ─────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.manifest
*.spec

# Virtual environments
venv/
.venv/
env/

# Python version
.python-version

# ── Jupyter Notebooks ───────────────────────────────────────────────
*.ipynb_checkpoints/
.ipynb_checkpoints/
# Keep outputs out of git (keep code only)
.ipynb
# If you want to keep notebooks in git, comment the line above and use:
# *.ipynb  filters below in a .gitattributes file instead

# ── Data & Output ───────────────────────────────────────────────────
data_output/
*.csv
*.parquet
*.feather

# ── Docker volumes (NEVER commit) ──────────────────────────────────
# Named volumes are stored in /var/lib/docker/volumes/
# Never reference them here — they are managed by docker-compose

# ── ML & Models ────────────────────────────────────────────────────
backend/models/artifacts/*.pkl
backend/models/artifacts/*.h5
backend/models/artifacts/*.pt
backend/models/artifacts/*.onnx
backend/models/artifacts/*.joblib
mlruns/
mlartifacts/
TASK_ASSIGNMENT.md
*.pth
*.ckpt
*.h5

# ── Logs ───────────────────────────────────────────────────────────
*.log
logs/
airflow/logs/

# ── IDE ────────────────────────────────────────────────────────────
.idea/
.vscode/
SKILLS.md
TASKS.md
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Node (frontend) ────────────────────────────────────────────────
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/
frontend/.next/
frontend/out/
frontend/build/

# ── TypeScript (frontend) ───────────────────────────────────────────
frontend/.turbo/
*.tsbuildinfo

