airflow/logs/

# ── Kafka / Zookeeper (local dev data) ─────────────────────────────
kafka-data/
zookeeper-data/

# ── TimescaleDB / Redis (local dev data) ──────────────────────────
# Named volumes are managed by docker-compose — DO NOT add them here
# But local dev data can be ignored:
*.sql_dump
*.backup

# ── Claude Code (plan files, memory) ───────────────────────────────
.claude/
# Uncomment below only if you want to exclude plan files from git:
# .claude/plans/

# ── Confidential project docs ───────────────────────────────────────
docs/REIS_Stage1_2_Docs.docx   # Remove from git if sensitive
docs/REIS_Project_Plan.docx
docs/*

